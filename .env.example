# Optional server-side Gemini key. Never prefix this with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# DATABASE_URL: Primary PostgreSQL connection string for production database.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# Optional granular database parameters
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Required to enable protected curator operations. Set a strong secret on the server only.
ADMIN_ACCESS_PASSCODE=
ADMIN_SESSION_TTL_MINUTES=480

# OCR remains unavailable until enabled and Tesseract plus Poppler or MuPDF are installed.
TESSERACT_ENABLED=false
TESSERACT_PATH=
PDF_RENDERER_TOOL=pdftoppm
PDF_RENDERER_PATH=

# QR continuation sessions expire after this many minutes (5–240).
QR_SESSION_TTL_MINUTES=30
